data: {"code":0,"message":"success","data":{"answer":"前，铁路运输企业应当组织对其","reference":{},"final":false}}

data: {"code":0,"message":"success","data":{"answer":"**安全性、可靠性和可维修性**","reference":{},"final":false}}

data: {"code":0,"message":"success","data":{"answer":"进行技术评估，确认符合国家标准","reference":{},"final":false}}

data: {"code":0,"message":"success","data":{"answer":"、行业标准、技术规范后方可","reference":{},"final":false}}

