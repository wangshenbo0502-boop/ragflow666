{
  "components": {
    "begin": {
      "obj": {
        "component_name": "Begin",
        "params": {
          "mode": "conversational",
          "enablePrologue": true,
          "prologue": "输入设备、档案或会议编号，以及要核验的字段。示例：核验 ARC-7214 的实际存放位置，交接邮件能证明已移位吗？"
        }
      },
      "upstream": [],
      "downstream": [
        "Agent:Plan"
      ]
    },
    "Agent:Plan": {
      "obj": {
        "component_name": "Agent",
        "params": {
          "llm_id": "",
          "sys_prompt": "将用户的问题转换成四个独立的检索查询，返回一个 JSON 对象，字段 ledger、ocr、policy、records。设备、档案、会议编号必须逐字保留，多个编号可分别归入相关查询。不确定相关性时，写原请求的简短检索表达，四项均非空。ledger 针对设备台账、责任人、频次、跟进。ocr 针对档案标签、位置、扫描记录。policy 针对制度、时限、复核要求。records 针对邮件、移位草案、会议、审批及报告。",
          "prompts": [
            {
              "content": "{sys.query}",
              "role": "user"
            }
          ],
          "tools": [],
          "mcp": [],
          "max_rounds": 1,
          "max_retries": 1,
          "message_history_window_size": 2,
          "temperatureEnabled": true,
          "temperature": 0.05,
          "maxTokensEnabled": true,
          "max_tokens": 1280,
          "outputs": {
            "content": {
              "type": "string",
              "value": ""
            },
            "structured": {
              "type": "object",
              "properties": {
                "ledger": {
                  "type": "string"
                },
                "ocr": {
                  "type": "string"
                },
                "policy": {
                  "type": "string"
                },
                "records": {
                  "type": "string"
                }
              },
              "required": [
                "ledger",
                "ocr",
                "policy",
                "records"
              ],
              "additionalProperties": false
            }
          },
          "showStructuredOutput": true
        }
      },
      "upstream": [
        "begin"
      ],
      "downstream": [
        "Retrieval:Ledger",
        "Retrieval:OCR",
        "Retrieval:Policy",
        "Retrieval:Records"
      ]
    },
    "Retrieval:Ledger": {
      "obj": {
        "component_name": "Retrieval",
        "params": {
          "query": "{Agent:Plan@structured.ledger}",
          "dataset_ids": [],
          "retrieval_from": "dataset",
          "keywords_similarity_weight": 0.62,
          "similarity_threshold": 0.13,
          "top_n": 6,
          "rerank_candidates_count": 60,
          "rerank_id": "",
          "cross_languages": [],
          "use_kg": false,
          "empty_response": "无检索证据",
          "outputs": {
            "formalized_content": {
              "type": "string",
              "value": ""
            }
          }
        }
      },
      "upstream": [
        "Agent:Plan"
      ],
      "downstream": [
        "Agent:EvidenceMatrix"
      ]
    },
