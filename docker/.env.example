# Copy this file to docker/.env on a new checkout.
# Create an empty docker/.env.local (also required by Compose).
# Replace change-...-password values before starting new data volumes.
# Keep real credentials in ignored .env/.env.local files, never in this template.

# Deployment selection. Build or obtain this custom image before startup.
DOC_ENGINE=${DOC_ENGINE:-elasticsearch}
DB_TYPE=${DB_TYPE:-mysql}
DEVICE=${DEVICE:-cpu}
METADATA_DB_PROFILE=${METADATA_DB_PROFILE:-mysql}
COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE},metadata-${METADATA_DB_PROFILE}
RAGFLOW_IMAGE=ragflow:railmind-v1.0.0
MEM_LIMIT=8073741824
TZ=Asia/Shanghai

# Elasticsearch (default) and optional OpenSearch / Kibana.
STACK_VERSION=${STACK_VERSION:-8.11.3}
ES_HOST=es01
ES_PORT=1200
ELASTIC_PASSWORD=change-elastic-password
OS_HOST=opensearch01
OS_PORT=1201
OPENSEARCH_PASSWORD=Change-OpenSearch-Password-2026!
KIBANA_PORT=6601

# Optional document engines.
INFINITY_HOST=infinity
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432
SERENEDB_HOST=serenedb
SERENEDB_PORT=7890
SERENEDB_PASSWORD=change-serenedb-password
OCEANBASE_HOST=oceanbase
OCEANBASE_PORT=2881
OCEANBASE_USER=root@ragflow
OCEANBASE_PASSWORD=change-oceanbase-password
OCEANBASE_DOC_DBNAME=ragflow_doc
OB_CLUSTER_NAME=${OB_CLUSTER_NAME:-ragflow}
OB_TENANT_NAME=${OB_TENANT_NAME:-ragflow}
OB_SYS_PASSWORD=${OCEANBASE_PASSWORD}
OB_TENANT_PASSWORD=${OCEANBASE_PASSWORD}
OB_MEMORY_LIMIT=${OB_MEMORY_LIMIT:-10G}
OB_SYSTEM_MEMORY=${OB_SYSTEM_MEMORY:-2G}
OB_DATAFILE_SIZE=${OB_DATAFILE_SIZE:-20G}
OB_LOG_DISK_SIZE=${OB_LOG_DISK_SIZE:-20G}
SEEKDB_HOST=seekdb
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=change-seekdb-password
SEEKDB_DOC_DBNAME=ragflow_doc
SEEKDB_MEMORY_LIMIT=2G
GAUSSDB_HOST=
GAUSSDB_PORT=
GAUSSDB_DATABASE=postgres
GAUSSDB_USER=
GAUSSDB_PASSWORD=
GAUSSDB_SCHEMA=
VB_HOST=vastbase
VB_PORT=5432
EXPOSE_VB_PORT=5432
VB_USERNAME=ragflow
VB_PASSWORD=change-vb-password
VB_VEC_DBNAME=ragflow
VB_META_DBNAME=rag_flow
VB_DBCOMPATIBILITY=B
VB_SSL_MODE=disable

# MySQL metadata database. Use new passwords only when initializing new volumes.
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=3306
EXPOSE_MYSQL_PORT=127.0.0.1:3307
MYSQL_PASSWORD=change-mysql-password
MYSQL_MAX_PACKET=1073741824
GAUSSDB_METADATA_HOST=
GAUSSDB_METADATA_PORT=
GAUSSDB_METADATA_USER=
GAUSSDB_METADATA_PASSWORD=
GAUSSDB_METADATA_DBNAME=rag_flow
GAUSSDB_METADATA_SCHEMA=public
GAUSSDB_METADATA_MAX_CONNECTIONS=100
GAUSSDB_METADATA_STALE_TIMEOUT=30

# Object storage, cache, queue, and tracing.
MINIO_HOST=minio
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000
MINIO_USER=rag_flow
MINIO_PASSWORD=change-minio-password
KVROCKS_HOST=kvrocks
KVROCKS_PORT=6379
REDIS_PASSWORD=change-redis-password
NATS_HOST=nats
NATS_PORT=4222
EXPOSE_NATS_PORT=4222
EXPOSE_NATS_MONITORING_PORT=8222
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_TCP_PORT=9000
EXPOSE_CLICKHOUSE_TCP_PORT=9900
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=ragflow
CLICKHOUSE_PASSWORD=change-clickhouse-password
CLICKHOUSE_DATABASE=ragflow
JAEGER_VERSION=2.19.0
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# Application ports and first-run administration.
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
ADMIN_DEFAULT_PASSWORD=change-admin-default-password
ALLOW_ANY_HOST=0
REGISTER_ENABLED=1
ENABLE_REGISTER=1
DISABLE_PASSWORD_LOGIN=false
USE_DOCLING=false
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
THREAD_POOL_MAX_WORKERS=128

# Optional TEI embedding service.
TEI_IMAGE_CPU=infiniflow/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=infiniflow/text-embeddings-inference:1.8
TEI_MODEL=${TEI_MODEL:-Qwen/Qwen3-Embedding-0.6B}
TEI_HOST=tei
TEI_PORT=6380

# Ingestion and knowledge compilation.
DOC_BULK_SIZE=${DOC_BULK_SIZE:-4}
EMBEDDING_BATCH_SIZE=${EMBEDDING_BATCH_SIZE:-16}
RERANK_TOKEN_LIMIT_MODE=${RERANK_TOKEN_LIMIT_MODE:-truncate}
WIKI_MAP_LLM_POOL_SIZE=20
WIKI_MAP_MAX_PENDING=25
WIKI_REFINE_WORKERS=4
WIKI_MAP_WORKERS=20
WIKI_MAP_TIMEOUT=600
WIKI_REDUCE_TIMEOUT=60
WIKI_PLAN_TIMEOUT=600
WIKI_REFINE_TIMEOUT=300
WIKI_MERGE_TIMEOUT=600
DOC_STRUCTURE_COMPILE_BATCH_CHUNKS=4
DOC_STRUCTURE_COMPILE_MAX_IN_FLIGHT=15
DOC_STRUCTURE_LLM_POOL_SIZE=20
STRUCTURE_CONTEXT_FRACTION=0.5
STRUCTURE_DEFAULT_CONTEXT=100000
KNOWLEDGE_GRAPH_CONTEXT_FRACTION=0.1
KNOWLEDGE_GRAPH_MIN_BATCH_TOKENS=2048
KNOWLEDGE_GRAPH_MAX_BATCH_TOKENS=4096
STRUCTURE_CHAIN_CORRECTION_TIMEOUT_S=120
LLM_POOL_RATE_LIMIT_RETRIES=3
LLM_POOL_RATE_LIMIT_RETRY_BASE_DELAY=1.0
LLM_POOL_RATE_LIMIT_RETRY_MAX_DELAY=30.0

# Optional model settings. Configure providers/default models in the UI too.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Requires a separately installed Ollama service with bge-m3 downloaded.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Optional chat media. Supply your tenant ID and image provider key privately.
# Speech/music endpoints require separately prepared local engines and models.
RAGFLOW_MEDIA_TENANT_ID=
RAGFLOW_IMAGE_BASE_URL=
RAGFLOW_IMAGE_MODEL=gpt-image-2.5-sunburst
RAGFLOW_IMAGE_API_KEY=
RAGFLOW_TTS_BASE_URL=http://host.docker.internal:18880
RAGFLOW_MUSIC_BASE_URL=http://host.docker.internal:18881
