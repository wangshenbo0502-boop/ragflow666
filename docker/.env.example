# Copy the values you need into docker/.env before starting RAGFlow.
# Never commit a real API key.

# Local database and RAGFlow image
MYSQL_PASSWORD=000000
EXPOSE_MYSQL_PORT=127.0.0.1:3307
RAGFLOW_IMAGE=ragflow:go-local

# DeepSeek chat model
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-flash

# Local bge-m3 embedding model served by Ollama
OLLAMA_BASE_URL=http://ragflow-ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
